{
  "name": "zebra-inventory-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:demo",
    "dev:demo": "NEXT_PUBLIC_APP_MODE=demo next dev",
    "dev:live": "NEXT_PUBLIC_APP_MODE=live next dev --port 3001",
    "build": "next build",
    "build:demo": "NEXT_PUBLIC_APP_MODE=demo next build",
    "build:live": "NEXT_PUBLIC_APP_MODE=live next build",
    "start": "npm run start:demo",
    "start:demo": "NEXT_PUBLIC_APP_MODE=demo next start",
    "start:live": "NEXT_PUBLIC_APP_MODE=live next start --port 3001",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "supabase:start": "npx --yes supabase@2.113.0 start",
    "supabase:reset": "npx --yes supabase@2.113.0 db reset --local",
    "supabase:test": "npx --yes supabase@2.113.0 test db --local supabase/tests/database",
    "supabase:verify": "npm run supabase:reset && npm run supabase:test",
    "supabase:concurrency": "node supabase/tests/concurrency/run.mjs",
    "supabase:security-smoke": "node supabase/tests/security/pilot-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.8",
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.21",
    "jsdom": "^24.1.3",
    "tailwindcss": "4.1.18",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
